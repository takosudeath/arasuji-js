{
  "manifest_version": 3,
  "name": "arasuji：前回のあらすじ",
  "version": "0.1.0",
  "description": "長文ページを再開するときに「前回のあらすじ」を音声で聞けるようにします。",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "arasuji", "default_popup": "popup.html" },
  "commands": {
    "run-arasuji": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "このページで arasuji を使う（動いていればあらすじを読む）"
    }
  }
}
